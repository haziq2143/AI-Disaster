# AI Disaster Assistant - Konfigurasi Lingkungan
# Peta menggunakan Leaflet + OpenStreetMap (tanpa API key eksternal)
DATABASE_URL=
DATABASE_POOL_MAX=10
# Aktifkan hanya jika reverse proxy tepercaya menimpa X-Real-IP atau X-Forwarded-For.
TRUST_PROXY_HEADERS=false
APP_BASE_URL=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DATABASE_BACKUP_DIR=
DATABASE_RESTORE_FILE=
# Set only after reviewing the target database and backup file.
DATABASE_RESTORE_CONFIRM=

# Email admin awal. Daftarkan akun ini bersama kode bootstrap di bawah.
INITIAL_ADMIN_EMAIL=
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INITIAL_ADMIN_SECRET=
